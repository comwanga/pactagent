# Local infrastructure (safe defaults)
PACTAGENT_ECONOMIC_MODE=live
PACTAGENT_LIVE_RELAY_URL=wss://localhost:8443
PACTAGENT_CASHU_TEST_MINT_URL=https://testnut.cashu.space
PACTAGENT_LIVE_STATE_DIRECTORY=.local/pactagent-state
# Optional dedicated override; otherwise requester ownership uses the state directory above.
PACTAGENT_REQUESTER_SESSION_DATABASE=.local/pactagent-state/requester-sessions.sqlite
PACTAGENT_RUNTIME_API_BASE=http://localhost:3000
PACTAGENT_REQUESTER_UI_ORIGIN=http://localhost:3000
PACTAGENT_LOCAL_CA_PATH=.local/pactagent-ca/root.crt

# Demo mode configuration (DEMO SATS HAVE NO MONETARY VALUE)
# Required only when PACTAGENT_ECONOMIC_MODE=demo
PACTAGENT_DEMO_CASHU_MINT_URL=http://localhost:3338
PACTAGENT_DEMO_STATE_DIRECTORY=.local/pactagent-demo-state
PACTAGENT_DEMO_NORMAL_SPEND_KEY=
PACTAGENT_DEMO_REFUND_SPEND_KEY=
PACTAGENT_DEMO_FUNDING_REFERENCE=
PACTAGENT_DEMO_WALLET_INITIAL_BALANCE_SATS=1000
# Optional, comma-separated DNS hostnames (no IPs, no wildcards) allowed for
# HTTP demo-mint transport on a private deployment network (Issue #39).
# HTTPS and HTTP loopback always remain allowed. Live mode ignores this list.
PACTAGENT_DEMO_MINT_PRIVATE_HOSTS=

# Local API authorization secret
PACTAGENT_RUNTIME_API_TOKEN=

# Nostr identity secrets (generate separate keys; never reuse production keys)
PACTAGENT_LIVE_REQUESTER_PRIVATE_KEY=
PACTAGENT_LIVE_PROVIDER_PRIVATE_KEY=
PACTAGENT_LIVE_ESCROW_AUTHORITY_PRIVATE_KEY=
# Public key of the escrow authority (derived from the private key above).
# Required by the standalone provider service to create escrow authority bindings.
PACTAGENT_LIVE_ESCROW_AUTHORITY_PUBLIC_KEY=
# F38-01: Provider public key — required in hosted mode (PACTAGENT_RUNTIME_MODE=hosted).
# The runtime uses this to discover the provider through the relay WITHOUT
# possessing the provider private key. In local mode, the provider private key is used instead.
PACTAGENT_LIVE_PROVIDER_PUBLIC_KEY=
# F38-01: Runtime deployment mode. "local" (inline provider) or "hosted" (external provider).
# In hosted mode, the runtime does NOT load PACTAGENT_LIVE_PROVIDER_PRIVATE_KEY.
# F38-06A: Missing or invalid values FAIL CLOSED — no silent fallback to local.
PACTAGENT_RUNTIME_MODE=local

# Provider service configuration (Issue #38 hosted Nostr/P002 infrastructure)
# F38-06A: Missing or invalid values FAIL CLOSED — no silent default to local.
PACTAGENT_PROVIDER_MODE=local
PACTAGENT_PROVIDER_OFFER_SATS=350
PACTAGENT_PROVIDER_MAX_EXECUTION_SECONDS=120
PACTAGENT_PROVIDER_ESCROW_TIMEOUT_SECONDS=900
PACTAGENT_PROVIDER_POLL_INTERVAL_MS=3000
PACTAGENT_PROVIDER_TRANSITION_TIMEOUT_MS=120000
PACTAGENT_PROVIDER_STATE_DIRECTORY=.local/provider-state
PACTAGENT_PROVIDER_DEFINITION_ID=hosted-provider
PACTAGENT_PROVIDER_OFFER_ID=hosted-document-summary-offer
PACTAGENT_PROVIDER_ESCROW_DESCRIPTOR_ID=hosted-cashu-escrow
PACTAGENT_HOSTED_WSS_HOSTNAME=localhost

# Cashu NUT-11 spending secrets
PACTAGENT_LIVE_NORMAL_SPEND_KEY=
PACTAGENT_LIVE_REFUND_SPEND_KEY=

# Testnut-only test ecash and its opaque local reference
PACTAGENT_LIVE_FUNDING_TOKEN=
PACTAGENT_LIVE_FUNDING_REFERENCE=

# Requester recommendation mode (deterministic is the local/CI default)
PACTAGENT_REQUESTER_DECISION_MODE=deterministic

# Required only when PACTAGENT_REQUESTER_DECISION_MODE=model
PACTAGENT_REQUESTER_MODEL_PROVIDER=openai
PACTAGENT_REQUESTER_MODEL_NAME=
PACTAGENT_REQUESTER_MODEL_API_KEY=
