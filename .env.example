# Local infrastructure (safe defaults)
PACTAGENT_LIVE_RELAY_URL=wss://localhost:8443
PACTAGENT_CASHU_TEST_MINT_URL=https://testnut.cashu.space
PACTAGENT_LIVE_STATE_DIRECTORY=.local/pactagent-state
PACTAGENT_RUNTIME_API_BASE=http://localhost:3000
PACTAGENT_LOCAL_CA_PATH=.local/pactagent-ca/root.crt

# Local API authorization secret
PACTAGENT_RUNTIME_API_TOKEN=

# Nostr identity secrets (generate separate keys; never reuse production keys)
PACTAGENT_LIVE_REQUESTER_PRIVATE_KEY=
PACTAGENT_LIVE_PROVIDER_PRIVATE_KEY=
PACTAGENT_LIVE_ESCROW_AUTHORITY_PRIVATE_KEY=

# Cashu NUT-11 spending secrets
PACTAGENT_LIVE_NORMAL_SPEND_KEY=
PACTAGENT_LIVE_REFUND_SPEND_KEY=

# Testnut-only test ecash and its opaque local reference
PACTAGENT_LIVE_FUNDING_TOKEN=
PACTAGENT_LIVE_FUNDING_REFERENCE=
