{
  "name": "pactagent",
  "version": "0.1.0",
  "description": "Autonomous agents contracting and settling over open Bitcoin protocols.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/comwanga/pactagent.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --maxWorkers=1 src/domain/pact-service-agreement.test.ts src/domain/private-task-transport.test.ts src/lib/provider-discovery.test.ts src/lib/pact-service-agreement-publication.test.ts src/lib/private-task-transport.test.ts src/lib/cashu-escrow-settlement.test.ts",
    "test:e2e": "vitest run --maxWorkers=1 src/lib/pactagent-workflow.test.ts",
    "test:live": "vitest run --config vitest.live.config.ts --maxWorkers=1 src/lib/pactagent-workflow.live.test.ts",
    "test:runtime": "vitest run --maxWorkers=1 src/lib/pactagent-runtime.test.ts src/lib/pactagent-runtime-api.test.ts",
    "test:process": "vitest run --config vitest.process.config.ts",
    "test:blackbox": "next build && vitest run --config vitest.live.config.ts --maxWorkers=1 src/lib/pactagent-runtime.blackbox.test.ts",
    "test:local:testnut": "node scripts/run-with-local-ca.mjs scripts/test-local-testnut.mjs",
    "local:up": "node scripts/local-up.mjs",
    "local:doctor": "node scripts/run-with-local-ca.mjs scripts/local-doctor.mjs --allow-missing-ca",
    "local:down": "node scripts/local-down.mjs",
    "local:reset-state": "node scripts/local-reset-state.mjs",
    "runtime:start": "next start",
    "runtime:start:local": "node scripts/runtime-start-local.mjs",
    "runtime:bootstrap": "node scripts/runtime-bootstrap.mjs"
  },
  "dependencies": {
    "@cashu/cashu-ts": "4.10.1",
    "next": "16.3.4",
    "nostr-tools": "2.25.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "16.3.4",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
