{
  "name": "pactagent",
  "version": "0.1.0",
  "description": "Autonomous agents contracting and settling over open Bitcoin protocols.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/comwanga/pactagent.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --maxWorkers=1 src/domain/pact-service-agreement.test.ts src/domain/private-task-transport.test.ts src/lib/provider-discovery.test.ts src/lib/pact-service-agreement-publication.test.ts src/lib/private-task-transport.test.ts src/lib/cashu-escrow-settlement.test.ts",
    "test:e2e": "vitest run --maxWorkers=1 src/lib/pactagent-workflow.test.ts",
    "test:live": "vitest run --config vitest.live.config.ts --maxWorkers=1 src/lib/pactagent-workflow.live.test.ts",
    "test:runtime": "vitest run --maxWorkers=1 src/lib/pactagent-runtime.test.ts src/lib/pactagent-runtime-api.test.ts",
    "test:process": "vitest run --config vitest.process.config.ts",
    "test:blackbox": "next build && vitest run --config vitest.live.config.ts --maxWorkers=1 src/lib/pactagent-runtime.blackbox.test.ts",
    "pretest:e2e:requester": "node scripts/prepare-requester-e2e.mjs",
    "test:e2e:requester": "node scripts/run-requester-e2e.mjs",
    "test:e2e:requester:live": "node scripts/run-requester-e2e-live.mjs",
    "test:phase5": "vitest run src/lib/requester-live-e2e-boundary.test.ts",
    "test:demo-economic:live": "node scripts/run-demo-mint-suite.mjs vitest.demo-economic.config.ts",
    "test:demo-wallet:live": "node scripts/run-demo-mint-suite.mjs vitest.demo-wallet.config.ts",
    "test:strfry-boundary:live": "vitest run --configLoader runner --config vitest.live.config.ts src/lib/strfry-size-boundary.live.test.ts",
    "audit:client-bundle": "node scripts/audit-requester-client-bundle.mjs",
    "test:hosted-nostr:live": "node scripts/run-hosted-protocol-acceptance.mjs",
    "test:demo-repeatability:e2e": "node scripts/run-hosted-protocol-acceptance.mjs --repeatability",
    "test:provider:live": "vitest run --configLoader runner --config vitest.live.config.ts --maxWorkers=1 src/lib/pactagent-provider-service.live.test.ts",
    "test:hosted-protocol:live": "vitest run --configLoader runner --config vitest.live.config.ts --maxWorkers=1 src/lib/pactagent-provider-service.live.test.ts src/lib/strfry-size-boundary.live.test.ts",
    "test:hosted-e2e:live": "vitest run --configLoader runner --config vitest.live.config.ts --maxWorkers=1 src/lib/hosted-protocol-full-e2e.live.test.ts",
    "hosted:doctor": "node --import tsx scripts/hosted-doctor.mjs",
    "railway:doctor": "node --import tsx scripts/railway-doctor.mjs",
    "railway:acceptance": "node scripts/run-railway-acceptance.mjs",
    "provider:start": "node --conditions=react-server --import tsx scripts/provider-start.mjs",
    "test:local:testnut": "node scripts/run-with-local-ca.mjs scripts/test-local-testnut.mjs",
    "requester:model:doctor": "vitest run --config vitest.model.config.ts --configLoader runner --maxWorkers=1",
    "local:up": "node scripts/local-up.mjs",
    "local:doctor": "node scripts/run-with-local-ca.mjs scripts/local-doctor.mjs --allow-missing-ca",
    "local:down": "node scripts/local-down.mjs",
    "local:reset-state": "node scripts/local-reset-state.mjs",
    "runtime:start": "next start",
    "runtime:start:local": "node scripts/runtime-start-local.mjs",
    "runtime:bootstrap": "node scripts/runtime-bootstrap.mjs"
  },
  "dependencies": {
    "@cashu/cashu-ts": "4.10.1",
    "next": "16.3.8",
    "nostr-tools": "2.25.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "16.3.8",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "railway": "^3.12.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
